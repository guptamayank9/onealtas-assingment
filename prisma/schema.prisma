// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
enum ModelType {
  TEXT
  IMAGE
  EMBEDDING
  VIDEO
  SPEECH
  TRANSCRIPTION
  RERANKING
  REALTIME
}

model Lab {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  website     String?
  country     String?
  models      Model[]
  createdAt   DateTime @default(now())
}

model Provider {
  id        String          @id @default(cuid())
  name      String          @unique
  slug      String          @unique
  website   String?
  listings  ModelProvider[]
  createdAt DateTime        @default(now())
}

model Model {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  description      String?
  type             ModelType @default(TEXT)
  contextWindow    Int?
  maxOutputTokens  Int?
  inputModalities  String[]
  outputModalities String[]
  reasoning        Boolean  @default(false)
  toolCalling      Boolean  @default(false)
  structuredOutput Boolean  @default(false)
  vision           Boolean  @default(false)
  openWeights      Boolean  @default(false)
  deprecated       Boolean  @default(false)
  releasedAt       DateTime?
  labId            String
  lab              Lab      @relation(fields: [labId], references: [id])
  providers        ModelProvider[]
  scores           BenchmarkScore[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([labId])
  @@index([type])
  @@index([releasedAt])
}
  providerCount    Int      @default(0)
  minInputPrice    Float?
  minOutputPrice   Float?

model ModelProvider {
  id               String   @id @default(cuid())
  modelId          String
  providerId       String
  inputPricePer1M  Float?
  outputPricePer1M Float?
  cachePricePer1M  Float?
  model            Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  provider         Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([modelId, providerId])
  @@index([providerId])
}

model Benchmark {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  category    String
  description String?
  scores      BenchmarkScore[]
}

model BenchmarkScore {
  id          String    @id @default(cuid())
  modelId     String
  benchmarkId String
  score       Float
  model       Model     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  benchmark   Benchmark @relation(fields: [benchmarkId], references: [id], onDelete: Cascade)

  @@unique([modelId, benchmarkId])
  @@index([benchmarkId, score])
}